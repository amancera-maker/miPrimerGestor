# =============================================================================
# GestorPyme — plantilla de variables (NO pegar secretos reales en Git)
# Copiar a .env (local) o cargar en Render / Supabase dashboard.
# =============================================================================

# --- Base de datos (Supabase) ---
# Preferir connection pooling (puerto 6543) en producción con ?sslmode=require
# Ejemplo pooler: postgresql://postgres.XXXX:PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require&pgbouncer=true
# Ejemplo directa (migraciones): postgresql://postgres:PASSWORD@db.XXXX.supabase.co:5432/postgres?sslmode=require
DATABASE_URL="postgresql://postgres:PASSWORD@db.XXXX.supabase.co:5432/postgres?sslmode=require"

# --- Clerk (producción: claves pk_live_ / sk_live_) ---
PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_xxxxxxxx"
CLERK_SECRET_KEY="sk_test_xxxxxxxx"

# Allowlist obligatoria en producción (correos del despacho, separados por coma)
AUTHORIZED_EMAILS="socio@tudespacho.mx,asistente@tudespacho.mx"

# Origen público SIN slash final. En Render debe coincidir con la URL del servicio.
# También definir ORIGIN con el mismo valor (CSRF / adapter-node).
PUBLIC_ORIGIN="https://gestorpyme.onrender.com"
ORIGIN="https://gestorpyme.onrender.com"

# --- Resend ---
RESEND_API_KEY="re_xxxxxxxx"
# Remitente verificado en Resend (dominio autenticado)
FROM_EMAIL="noreply@tudespacho.mx"

# --- Runtime ---
NODE_ENV="development"
# Solo desarrollo local. NUNCA en Render/producción (se ignora si NODE_ENV=production).
# DEV_BYPASS_AUTH="true"

# Datos del despacho (opcionales; también editables en ConfigDespacho)
DESPACHO_NOMBRE="Despacho Ejemplo"
DESPACHO_RFC="XAXX010101000"
DESPACHO_TELEFONO="+52 614 000 0000"
DESPACHO_CORREO="contacto@tudespacho.mx"
DESPACHO_DIRECCION="Calle Principal 123, Chihuahua, México"
DESPACHO_TRANSFERENCIA="CLABE: 000000000000000000 — Banco Ejemplo"
